OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4.1-mini
PEXELS_API_KEY=your-pexels-api-key

# --- TikTok (Content Posting API) ---
# Credenciales de la app en https://developers.tiktok.com
TIKTOK_CLIENT_KEY=aw324904gyav3xqp
TIKTOK_CLIENT_SECRET=1UiGrdtenXmpIOXMPvGZK9Dg79VgJuQR
# Redirect URI registrada en la app (para npm run tiktok:auth)
TIKTOK_REDIRECT_URI=http://localhost:3927/callback
# Respaldo del refresh_token (el normal se guarda en la tabla tiktok_tokens de Supabase)
TIKTOK_REFRESH_TOKEN=
# DIRECT_POST = publica solo | MEDIA_UPLOAD = borrador a la app de TikTok
TIKTOK_POST_MODE=DIRECT_POST
# SELF_ONLY mientras la app no pase la auditoria; PUBLIC_TO_EVERYONE despues
TIKTOK_PRIVACY_LEVEL=SELF_ONLY
# true = TikTok agrega musica de su libreria al carrusel de fotos
TIKTOK_AUTO_MUSIC=true
# Bucket publico de Supabase donde se suben los slides (TikTok los descarga de ahi)
TIKTOK_BUCKET=tiktok
TIKTOK_ENABLED=false
